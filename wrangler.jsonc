{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rag-cloudflare-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE_INDEX",
      "index_name": "belajar-rag"
    }
  ],
  "vars": {
    "OPENROUTER_EMBEDDING_MODEL": "text-embedding-3-small"
  }
}
